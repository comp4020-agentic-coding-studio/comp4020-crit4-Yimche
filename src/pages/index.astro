---
import Layout from "../layouts/Layout.astro";
import { SECTIONS } from "../lib/instrument.ts";
import { DEFAULT_BPM, DEFAULT_STEPS } from "../lib/sequencer.ts";

import stage from "../assets/art/stage.png";
import conductor from "../assets/art/conductor.png";
import lead from "../assets/art/lead.png";
import harmony from "../assets/art/harmony.png";
import bass from "../assets/art/bass.png";
import perc from "../assets/art/perc.png";

const art: Record<string, ImageMetadata> = { lead, harmony, bass, perc };

// Where each section stands on the stage, as % of the aspect-locked stage box.
// These mirror the two-tier zig-zag risers painted by
// scripts/art/generate.mjs: lead + bass sit on the lower front step, harmony +
// perc on the upper back step, interlocking left to right. Anchored bottom,
// centred left.
const spot: Record<string, { left: number; bottom: number; w: number }> = {
  lead: { left: 43, bottom: 22, w: 16 },
  harmony: { left: 57, bottom: 32, w: 16 },
  bass: { left: 72, bottom: 22, w: 13 },
  perc: { left: 86, bottom: 32, w: 12 },
};

// Every spotlight hangs from the same lighting truss near the top of the stage,
// so the cones all descend from one consistent height; only their length varies
// to reach each performer's own tier. TRUSS is that shared top edge (% down from
// the top of the stage box).
const TRUSS = 5;
const beamHeight = (bottom: number) => 100 - TRUSS - Math.max(0, bottom - 6);

// The four section beams plus the director's, all sharing the truss top. Width
// scales with length so every cone keeps the same opening angle (width is % of
// the stage width, height is % of its height; the 0.3 factor matches them).
const beamWidth = (height: number) => Math.round(height * 0.3);
const beams = [
  ...Object.entries(spot).map(([id, s]) => ({
    id,
    left: s.left,
    height: beamHeight(s.bottom),
    width: beamWidth(beamHeight(s.bottom)),
    hue: `var(--hue-${id})`,
  })),
  {
    id: "director",
    left: 36,
    height: beamHeight(26),
    width: beamWidth(beamHeight(26)),
    hue: "#fff3cf",
  },
];

const rowsTopDown = (rows: number) =>
  Array.from({ length: rows }, (_, i) => rows - 1 - i);
const cols = Array.from({ length: DEFAULT_STEPS }, (_, i) => i);
---

<Layout
  title="8-Bit Orchestra"
  description="Conduct a pixel-art chiptune orchestra in your browser: wake the conductor, tap a musician to write their part, and the ensemble loops live while the stage lights follow the sound."
>
  <header>
    <nav aria-label="Primary"><a href="./">8-Bit Orchestra</a></nav>
  </header>

  <main class="app">
    <!-- The immersive stage. It doubles as the state display: each musician is
         dim until its part is playing, then lit in the section's colour. -->
    <div class="stage" data-theatre>
      <img class="backdrop" src={stage.src} alt="" width={stage.width} height={stage.height} />

      <!-- The show title hangs inside the proscenium, so it is positioned
           against the stage box (not the page) and holds at every viewport. -->
      <h1 class="show-title">8-Bit Orchestra</h1>

      <!-- The lighting rig: one cone per performer, all hung from the same truss
           so they descend from a consistent height. Behind the performers. -->
      <div class="beams" aria-hidden="true">
        {
          beams.map((b) => (
            <span
              class="beam"
              data-beam={b.id}
              style={`left:${b.left}%;top:${TRUSS}%;height:${b.height}%;width:${b.width}%;--hue:${b.hue}`}
            />
          ))
        }
      </div>

      {
        SECTIONS.filter((s) => s.id in spot).map((section) => (
          <button
            class="group"
            data-group={section.id}
            data-play
            type="button"
            aria-haspopup="dialog"
            aria-label={`Write the ${section.label} part`}
            style={`left:${spot[section.id].left}%;bottom:${spot[section.id].bottom}%;width:${spot[section.id].w}%;--hue:var(--hue-${section.id})`}
          >
            <img class="sprite" src={art[section.id].src} alt="" />
            <span class="tag">{section.label}</span>
          </button>
        ))
      }

      <button
        class="conductor"
        data-conductor
        data-play
        type="button"
        aria-label="Wake the orchestra and set the tempo"
        aria-haspopup="true"
        aria-expanded="false"
        style="left:36%;bottom:26%;width:6%"
      >
        <img class="sprite" src={conductor.src} alt="" />
      </button>

      <!-- The conductor sets the tempo, so the transport is his panel: it pops
           up over the podium when you tap him, the way tapping a musician opens
           their part. Hidden until then, not a permanent HUD. -->
      <div
        class="podium"
        data-transport-panel
        role="group"
        aria-label="Conductor's transport"
        hidden
      >
        <button data-tempo="-5" data-play type="button" aria-label="Slower">−</button>
        <span class="bpm" data-bpm aria-live="polite">{DEFAULT_BPM} BPM</span>
        <button data-tempo="5" data-play type="button" aria-label="Faster">+</button>
        <button data-transport data-play type="button" aria-pressed="false">Play</button>
      </div>

      <p class="invite" data-invite>
        Tap the conductor to wake the orchestra, then tap a musician to write
        their part.
      </p>
    </div>
  </main>

  <!-- The music layer: hidden until a musician is picked, gone again on Done.
       Every cell lives here from the start so the model and the contract can
       see it. -->
  <div class="editor" data-editor role="dialog" aria-label="Write a part" hidden>
    <div class="sheet">
      <div class="sheet-head">
        <h2 data-editor-title>Part</h2>
        <button class="done" data-done data-play type="button">Done</button>
      </div>
      {
        SECTIONS.map((section) => (
          <div
            class="rack"
            data-rack={section.id}
            style={`--hue:var(--hue-${section.id})`}
            hidden
          >
            <div class="grid" data-grid={section.id}>
              {rowsTopDown(section.rows).map((row) =>
                cols.map((col) => (
                  <button
                    class="cell"
                    data-cell
                    data-play
                    data-section={section.id}
                    data-row={row}
                    data-col={col}
                    type="button"
                    aria-pressed="false"
                    aria-label={`${section.label} row ${row + 1} beat ${col + 1}`}
                  />
                )),
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script src="../scripts/main.ts"></script>
</Layout>
